# hcOneshot 环境变量（HC_ 前缀），复制为 .env 使用
HC_CATALOG_COMPACT=4
#HC_API_BASE=http://10.18.217.60:30237/v1
HC_API_BASE=http://127.0.0.1:7000/v1
HC_API_KEY=
HC_MODEL=baseline
# 设备域虚拟 schema：0 = 关，设备参数改由「设备规则 + 设备对象词典」教模型直接写真实 operation/object
HC_DEVICE_VIRTUAL=0

# 工具目录：只读本地产物（运行期不依赖任何其他项目，不起 hcTools）
# 产物由 `python3 tools/build_catalog.py` 离线编译生成
HC_CATALOG_FILE=catalog.full.json

HC_MAX_QUERY_LEN=2000
HC_MAX_PLAN_STEPS=6
HC_PLAN_TRACE_TTL=300
# 槽值检索（结果追加到首轮 system prompt 末尾）；置空关闭
HC_SLOT_RETRIEVE_URL=
HC_SLOT_RETRIEVE_TIMEOUT=1.5
HC_PORT=8082

# 动态 few-shot context（规则提示 + BM25 相似示例，追加在首轮 system 末尾）；默认关
HC_FEWSHOT_ENABLED=1
# pattern_all_cat_ks.csv = pattern_all + vod category 增强示例，去掉不含「唱/K歌/点歌」的 K 歌误标示例
# （原 pattern_all_cat.csv 已在清理时删除，由此文件取代）
HC_FEWSHOT_LIB=experiments/retrieval/lib/pattern_all_cat_ks.csv
HC_FEWSHOT_TOPK=4
HC_FEWSHOT_MIN_SCORE=4.0
HC_FEWSHOT_EXCLUDE_SELF=1
# 多意图 few-shot 库（规则切出 ≥2 子句时注入）
HC_FEWSHOT_MULTI_LIB=experiments/retrieval/lib/multi_new.csv
# 实体：fewshot 侧实体词典（实体参考块 + 名字占位符检索）；entity_dict_dev = entity_dict + 设备对象/别名
# （由 tools/build_device_knowledge.py 生成）
HC_FEWSHOT_ENTITY_DICT=experiments/retrieval/lib/entity_dict_dev.csv
# 实体：app/entity.py 实体库参考块（与上一项同时开会注入两份实体块）
HC_ENTITY_ENABLED=1
# 规则库（动态检索注入）：rules_device = rules.csv + 9 条设备规则；每轮最多注入 HC_FEWSHOT_RULES_MAX 条
HC_FEWSHOT_RULES_LIB=experiments/retrieval/lib/rules_device.csv
HC_FEWSHOT_RULES_MAX=6
