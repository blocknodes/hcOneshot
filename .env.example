# hcOneshot 环境变量（HC_ 前缀），复制为 .env 使用
HC_API_BASE=http://127.0.0.1:7000/v1
HC_API_KEY=
HC_MODEL=baseline

# 工具目录：只读本地产物（运行期不依赖任何其他项目，不起 hcTools）
# 产物由 `python3 tools/build_catalog.py` 离线编译生成
HC_CATALOG_FILE=catalog.full.json
# 目录块档位：0=完整版(~38k token) 1=精简版，逐字重复说明合并为「同 <工具id>」(~30.7k) 2=极简版，用途/边界句+签名+字段名及短标签/枚举(~14.3k)
HC_CATALOG_COMPACT=0

HC_MAX_QUERY_LEN=2000
HC_MAX_PLAN_STEPS=6
HC_PLAN_TRACE_TTL=300
# 槽值检索（结果追加到首轮 system prompt 末尾）；置空关闭
HC_SLOT_RETRIEVE_URL=http://aibi-model.hisense.com:8091/retrieve
HC_SLOT_RETRIEVE_TIMEOUT=1.5
HC_PORT=8088

# 动态 few-shot context（规则提示 + BM25 相似示例，追加在首轮 system 末尾）；默认 0=关
# 开启时建议同时 HC_CATALOG_COMPACT=1（实验口径：精简目录 + 动态 context）
HC_FEWSHOT_ENABLED=0
HC_FEWSHOT_LIB=experiments/retrieval/lib/para_all.csv
HC_FEWSHOT_TOPK=4
HC_FEWSHOT_MIN_SCORE=4.0
HC_FEWSHOT_EXCLUDE_SELF=1
